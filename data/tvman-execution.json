{"meta":{"title":"电视机人 · 处决","subtitle":"Execution Timeline · 动画 / 特效分工","fps":30,"rev":1793874820651,"notes":["总长 14.00s（420F @30fps）；各段时长可直接在表头数字框里改","＊ 为表内暂无的建议资产名，待特效确认后补入《怪物-电视机人资源&排期》","Unity 程序版 Timeline：屏内 knock 与 trapped 顺序反了，应先 trapped（被困惊慌）再 knock（拍打）","处决中电视机人被击杀：立即打断，九屏逐块熄灭（另做，见 fx_tvman_death）","特效示意图截自《电视机人处决演示》，最终以美术资源为准"],"lock":false,"onlineRev":1,"savedAt":"2026-11-05T16:18:19.860Z"},"lanes":[{"id":"mon","name":"怪物","sub":"电视机人","dept":"anim","hue":"#4a7391","tall":false},{"id":"pout","name":"玩家 · 屏外","sub":"3D 身体","dept":"anim","hue":"#4f8470","tall":false},{"id":"pin","name":"玩家 · 屏内","sub":"九屏里的她","dept":"anim","hue":"#7d6fa8","tall":false},{"id":"cam","name":"镜头","sub":"运镜 / 震屏","dept":"cam","hue":"#a85a7a","tall":false},{"id":"fxs","name":"九屏","sub":"眼睛 / 屏幕","dept":"fx","hue":"#b98a35","tall":true},{"id":"fxw","name":"画面","sub":"粒子 / 闪屏","dept":"fx","hue":"#b0583f","tall":true}],"segments":[{"name":"抓人到拉近","short":"抓人","dur":2,"shot":"外部","beat":"抓起玩家，九屏红眼逐只锁定","kb":[1,1.12,50,40],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/61644596a648.jpg","cap":"手部命中，开始抓人"},{"label":"关键帧","at":0.35,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8177ed480596.jpg","cap":"玩家离地，红眼锁定"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/485c35547e83.jpg","cap":"举到九屏脸前"}]},{"name":"进行吸魂","short":"吸魂","dur":1.5,"shot":"外部 → 推满九屏","beat":"红眼转漩涡，灵魂被吸进屏幕","kb":[1,1.3,45,40],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/88aca1f30ccf.jpg","cap":"红眼转漩涡"},{"label":"关键帧","at":0.4,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/295f0650ab2b.jpg","cap":"灵魂流入九屏"},{"label":"关键帧","at":0.75,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/2b24538c56ca.jpg","cap":"推进到九宫格"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/5cb2750d7eb5.jpg","cap":"九宫格占满，雪花屏"}]},{"name":"困入屏幕","short":"困入","dur":2.5,"shot":"屏内","beat":"她在屏幕里惊醒，拼命拍打玻璃","kb":[1.04,1,50,50],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/e8942cac678f.jpg","cap":"雪花中显影"},{"label":"关键帧","at":0.4,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/006729ddf084.jpg","cap":"惊慌张望"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/2f4bbd69cc48.jpg","cap":"拍打，留下手印"}]},{"name":"拍出故障","short":"裂屏","dur":2.5,"shot":"屏内","beat":"第三下拍出故障，裂成九块小屏","kb":[1,1,50,50],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/7e53ce4d76eb.jpg","cap":"裂成 9 屏"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/49ee04db7729.jpg","cap":"每屏各自拍打"}]},{"name":"熄灭","short":"熄灭","dur":0.5,"shot":"屏内","beat":"屏幕狂闪，只剩左上角的她","kb":[1,1,50,50],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/aaa6fea05253.jpg","cap":"狂闪"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/67da3604d9f1.jpg","cap":"只剩左上角"}]},{"name":"静止 → 呐喊","short":"呐喊","dur":1,"shot":"屏内 · 推左上","beat":"她静静看着你，然后开始呐喊","kb":[1,1.18,22,22],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/fd676e3d7f47.jpg","cap":"静止凝视"},{"label":"关键帧","at":0.45,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/459c7c99697b.jpg","cap":"摆出呐喊"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/cc4140cebabc.jpg","cap":"完整呐喊"}]},{"name":"呐喊传染","short":"传染","dur":1,"shot":"屏内 · 拉全景","beat":"呐喊逐屏蔓延到九块屏幕","kb":[1.1,1,30,30],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/9b6fe7e24ca0.jpg","cap":"第一排同步"},{"label":"关键帧","at":0.5,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/6ca5910588f1.jpg","cap":"逐屏蔓延"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/39ab46819e0f.jpg","cap":"九屏同一张脸"}]},{"name":"合屏","short":"合屏","dur":1,"shot":"屏内","beat":"九屏拼成一张巨大的呐喊脸","kb":[1,1.1,50,50],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/941736a462b5.jpg","cap":"切到大画面"},{"label":"关键帧","at":0.5,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/e059b0da95f5.jpg","cap":"边框淡出"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8632706b2aee.jpg","cap":"一张大画面"}]},{"name":"CRT 关机","short":"关机","dur":1,"shot":"屏内","beat":"啪——画面收成一条线，熄灭","kb":[1.1,1.1,50,50],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8632706b2aee.jpg","cap":"定格"},{"label":"关键帧","at":0.5,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/995610e183da.jpg","cap":"压成亮线"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/1b3d6a720682.jpg","cap":"熄灭"}]},{"name":"丢弃尸体","short":"丢弃","dur":1.4,"shot":"外部","beat":"尸体落地，屏幕里闪过她的脸","kb":[1,1.06,60,60],"frames":[{"label":"首帧","at":0,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/b67e817b3edc.jpg","cap":"切回外部"},{"label":"关键帧","at":0.35,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/5c0d0629b1af.jpg","cap":"红眼复亮，松手"},{"label":"关键帧","at":0.7,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/9b990b3f01bf.jpg","cap":"尸体坠地"},{"label":"尾帧","at":1,"img":"https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/46be749e2899.jpg","cap":"左上闪过呐喊脸"}]}],"clips":[{"t":"pout","s":0,"u0":0,"e":0,"u1":1,"label":"被抓挣扎","res":"player@tvman_grabbed","mode":"loop","note":"离地后四肢乱蹬、挣扎，全程循环，身体跟随手部上提。"},{"t":"pout","s":1,"u0":0,"e":1,"u1":1,"label":"被吸魂 · 瘫软","res":"player@tvman_soul_drained","mode":"once","note":"被吸魂挣扎 → 逐渐瘫软；身体褪色、眼神失焦。资源 3s，这里用前 1.5s。"},{"t":"pout","s":2,"u0":0,"e":8,"u1":1,"label":"瘫软挂在手上（不出镜）","res":"","mode":"hold","note":"停在吸魂尾帧姿态，等切回外部镜头。"},{"t":"pout","s":9,"u0":0.3,"e":9,"u1":0.8,"label":"尸体坠地","res":"布娃娃 / 动画 待定","mode":"once","note":"灰败的尸体从手中坠落、翻转，落地弹一下后不动。"},{"t":"pin","s":2,"u0":0,"e":2,"u1":1,"label":"被困惊慌","res":"player@tvman_trapped","mode":"loop","note":"九屏合成一张大画面：抓头发、眼神乱瞟、急喘。"},{"t":"pin","s":3,"u0":0,"e":3,"u1":1,"label":"拍打屏幕","res":"player@tvman_knock","mode":"loop","note":"扑到屏幕上拍打 3 下，第 3 下拍出故障；裂成 9 屏后每屏各自拍打，节奏错开。"},{"t":"pin","s":4,"u0":0,"e":4,"u1":1,"label":"被困 · 凝视","res":"player@tvman_trapped（定格）","mode":"hold","note":"只剩左上角：她停下来，静静看着屏幕外。"},{"t":"pin","s":5,"u0":0,"e":5,"u1":1,"label":"静止 → 呐喊","res":"player@tvman_scream","mode":"once","note":"头慢慢歪 → 双手捧脸、嘴越张越大、身体拉长摇摆。"},{"t":"pin","s":6,"u0":0,"e":7,"u1":1,"label":"呐喊同步","res":"player@tvman_scream","mode":"loop","note":"从左到右、从上到下逐屏同步，每屏间隔约 0.2s；合屏结尾和镜头对视。"},{"t":"pin","s":8,"u0":0,"e":8,"u1":1,"label":"被困 · 定格","res":"player@tvman_trapped（呐喊后回到 trapped）","mode":"hold","note":"画面定格在呐喊。"},{"t":"pin","s":9,"u0":0.7,"e":9,"u1":1,"label":"闪过呐喊脸","res":"复用 scream 帧","mode":"once","note":"左上角屏幕闪 2~3 次她呐喊的脸。"},{"t":"cam","s":0,"u0":0,"e":0,"u1":1,"label":"推近到脸前","res":"","mode":"once","note":"跟拍抓取 → 随玩家上提推近到怪物脸前；命中瞬间轻震。"},{"t":"cam","s":1,"u0":0,"e":1,"u1":1,"label":"推满九宫格","res":"","mode":"once","note":"边吸边推近，直到 3×3 九宫格占满画面，无缝衔接屏内镜头。"},{"t":"cam","s":2,"u0":0,"e":4,"u1":1,"label":"固定 · 拍击震屏","res":"","mode":"hold","note":"固定在九宫格正面；每拍一下震屏，裂屏后持续小幅抖动。"},{"t":"cam","s":5,"u0":0,"e":5,"u1":1,"label":"推近左上","res":"","mode":"once","note":"缓慢推近到左上角屏幕。"},{"t":"cam","s":6,"u0":0,"e":6,"u1":1,"label":"拉回全景","res":"","mode":"once","note":"从左上角拉回九宫格全景。"},{"t":"cam","s":7,"u0":0,"e":8,"u1":1,"label":"微推 10%","res":"","mode":"once","note":"合屏时轻微推近，关机时固定。"},{"t":"cam","s":9,"u0":0,"e":9,"u1":1,"label":"外部中景 · 落地震","res":"","mode":"once","note":"外部中景；尸体落地瞬间震屏；末尾淡黑。"},{"t":"fxs","s":0,"u0":0,"e":0,"u1":1,"label":"红眼锁定 + 闪烁","res":"fx_tvman_eye_lock＊","mode":"loop","note":"红眼锁定玩家，每只眼依次锁定，之后循环红眼 + 闪烁。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/876bc01ecbc1.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/132396ec1c27.jpg"]},{"t":"fxs","s":1,"u0":0,"e":1,"u1":0.75,"label":"漩涡眼","res":"fx_tvman_eye_vortex","mode":"loop","note":"红眼瞳孔溶解成漩涡，吸魂时转蓝白。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/f63212543849.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/2b24538c56ca.jpg"]},{"t":"fxs","s":1,"u0":0.75,"e":1,"u1":1,"label":"雪花","res":"fx_tvman_static","mode":"once","note":"接近尾帧时九屏切雪花屏。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/f020c42d685e.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/67da3604d9f1.jpg"]},{"t":"fxs","s":2,"u0":0,"e":2,"u1":1,"label":"显影 · 手印裂纹","res":"fx_tvman_knock","mode":"once","note":"每拍一下，玻璃上留下发光手印和裂纹，画面震一下。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/006729ddf084.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/2f4bbd69cc48.jpg"]},{"t":"fxs","s":3,"u0":0,"e":3,"u1":1,"label":"撕裂 · RGB 分离","res":"fx_tvman_glitch","mode":"loop","note":"大画面撕裂、错位、RGB 分离，碎成 9 块小屏。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/7e53ce4d76eb.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/49ee04db7729.jpg"]},{"t":"fxs","s":4,"u0":0,"e":4,"u1":1,"label":"狂闪 → 雪花","res":"fx_tvman_glitch → fx_tvman_static","mode":"once","note":"全部屏幕狂闪，除左上角外切雪花。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/aaa6fea05253.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/67da3604d9f1.jpg"]},{"t":"fxs","s":5,"u0":0,"e":5,"u1":1,"label":"呐喊背景","res":"fx_tvman_scream","mode":"loop","note":"左上角背景变成扭曲色带，瞳孔变漩涡。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/459c7c99697b.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/cc4140cebabc.jpg"]},{"t":"fxs","s":6,"u0":0,"e":6,"u1":1,"label":"逐屏切换闪","res":"fx_tvman_scream · 切屏闪＊","mode":"once","note":"呐喊从左到右、从上到下逐屏同步，每屏切换闪一次。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/9b6fe7e24ca0.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/6ca5910588f1.jpg"]},{"t":"fxs","s":7,"u0":0,"e":7,"u1":1,"label":"合屏","res":"fx_tvman_merge","mode":"once","note":"边框淡出，9 块屏幕拼成一张大画面。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/941736a462b5.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/e059b0da95f5.jpg"]},{"t":"fxs","s":8,"u0":0,"e":8,"u1":1,"label":"CRT 关机","res":"fx_tvman_screen_off","mode":"once","note":"画面压成亮线，再收成亮点熄灭。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8632706b2aee.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/995610e183da.jpg"]},{"t":"fxs","s":9,"u0":0,"e":9,"u1":1,"label":"切回全红 + 闪烁","res":"fx_tvman_eye_red_on＊","mode":"once","note":"屏幕切回全红 + 闪烁，与丢弃尸体、吼叫同时发生。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/876bc01ecbc1.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/5c0d0629b1af.jpg"]},{"t":"fxw","s":0,"u0":0,"e":0,"u1":0.15,"label":"红闪","res":"fx_tvman_grab","mode":"once","note":"抓取成功瞬间全屏红闪约 4 帧。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/b8fe05f30165.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8177ed480596.jpg"]},{"t":"fxw","s":1,"u0":0,"e":1,"u1":0.85,"label":"吸魂粒子","res":"fx_tvman_soul_drain","mode":"loop","note":"蓝色灵魂粒子从玩家胸口螺旋流入九屏。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/295f0650ab2b.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/8c312e97f757.jpg"]},{"t":"fxw","s":1,"u0":0.85,"e":2,"u1":0.12,"label":"白闪","res":"fx_common_whiteflash＊","mode":"once","note":"外部镜头切屏内镜头的白闪转场。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/2b24538c56ca.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/fa15fe420152.jpg"]},{"t":"fxw","s":2,"u0":0.12,"e":8,"u1":1,"label":"扫描线 · CRT 暗角","res":"pp_tvman_crt_scanline＊","mode":"loop","note":"屏内镜头期间常驻扫描线、暗角和轻微噪点（后处理）。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/fd676e3d7f47.jpg"]},{"t":"fxw","s":9,"u0":0.7,"e":9,"u1":0.9,"label":"扬尘","res":"fx_tvman_drop","mode":"once","note":"尸体落地扬起一圈尘土；左上角屏幕闪出她呐喊的脸。","imgs":["https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/9b990b3f01bf.jpg","https://raw.githubusercontent.com/WayneBrysen/g119-works/main/data/img/46be749e2899.jpg"]},{"t":"mon","s":0,"u0":0,"e":0,"u1":1,"label":"把人拉近","res":"tvman@grab → tvman@execute_start","mode":"once","note":"单手抓起玩家（grab），攥紧后拉近到 9 块屏幕正前方（execute_start），头部微微前倾俯视玩家。"},{"t":"mon","s":1,"u0":0,"e":1,"u1":1,"label":"吸魂","res":"tvman@soul_drain_loop","mode":"loop","note":"大手托住玩家悬停在屏幕正前方，9 块屏幕前倾，机身随吸取节奏轻微震颤。"},{"t":"mon","s":2,"u0":0,"e":7,"u1":1,"label":"持续抖动（玩家在屏内挣扎）","res":"tvman@soul_drain_loop","mode":"loop","note":"镜头进入屏内，怪物不出镜；保持循环抖动，表示玩家正在屏幕里挣扎，方便之后切回外部镜头。"},{"t":"mon","s":8,"u0":0,"e":8,"u1":1,"label":"屏幕关闭（保持握持）","res":"沿用 soul_drain_loop","mode":"hold","note":"屏幕 CRT 关机期间怪物保持握持姿态，不换动作。"},{"t":"mon","s":9,"u0":0,"e":9,"u1":1,"label":"丢弃尸体 · 吼叫收尾","res":"tvman@drop","mode":"once","note":"大手松开，尸体从手中摔落地面弹一下；怪物随即吼叫收尾。丢弃与吼叫是同一个动作。"}]}